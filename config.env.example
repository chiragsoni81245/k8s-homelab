# Copy to config.env (gitignored). Everything here is also prompted for by setup.sh,
# and answers are saved to config.env automatically. Env vars of the same name win.

# CONTROL_PLANE_ENDPOINT=k8s-api.homelab.chiragsoni.org
# MASTER_IP=192.168.0.160            # master node IP (workers: where to join)
# POD_CIDR=10.244.0.0/16
# SERVICE_CIDR=10.96.0.0/12
# GITOPS_REPO_URL=git@github.com:chiragsoni81245/k8s-homelab.git
# GITOPS_REVISION=main
# DATA_MOUNT=/DATA                   # worker: existing data partition mount point
# DATA_PUID=1000                     # owner of the files on /DATA (docs only)
# DATA_PGID=1000
# ENABLE_SECRETS_ENCRYPTION=yes      # etcd encryption at rest for Secrets
# ENABLE_FIREWALL=no                 # optional ufw hardening (see scripts/15-firewall.sh)
