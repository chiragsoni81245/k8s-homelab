# Single source of truth for HOST-level versions. Edit, then: sudo ./update.sh <component>
# (Cluster add-on chart versions - Cilium, Argo CD, Envoy Gateway, ... - are pinned in
#  gitops/apps/*/*/application.yaml as `targetRevision`; bump them there and git push.)
#
# Looked up 2026-10-17. Compatibility: Envoy Gateway v1.9 supports Kubernetes v1.33-v1.36,
# so Kubernetes is pinned to the newest 1.36 patch (not 1.37) on purpose.

K8S_VERSION=1.36.5          # kubeadm / kubelet / kubectl (apt pkg prefix match, e.g. 1.36.5-*)
CONTAINERD_VERSION=2.4.2    # containerd.io from download.docker.com (apt prefix match)
HELM_VERSION=4.3.1          # helm binary (tarball + sha256 verified)
NETBIRD_VERSION=0.81.2      # netbird agent (apt, pkgs.netbird.io)
